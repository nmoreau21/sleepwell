# =============================================================================
# Sleepwell — Environment Variables
# Copy to .env.local for local development. Never commit secrets.
# See docs/technical-architecture.md
# =============================================================================

# --- Database (Supabase Postgres) ---
# App runtime: pooler (port 6543) is fine for queries.
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# Migrations (db:migrate): direct connection (port 5432) recommended if pooler auth fails.
# DATABASE_DIRECT_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://[project-ref].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only — never expose to client bundles
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Auth redirect (add in Supabase Dashboard → Authentication → URL Configuration):
#   Site URL: http://localhost:3000
#   Redirect URLs: http://localhost:3000/auth/callback

# --- Email (Step 11 — Resend) ---
RESEND_API_KEY=
EMAIL_FROM=hello@sleepwell.org
EMAIL_REPLY_TO=coordination@sleepwell.org

# --- Spam protection (public forms — Step 4+) ---
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# --- Monitoring ---
# SENTRY_DSN=

# --- Phase 5+ ---
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=

# --- Phase 6+ ---
# MAPBOX_ACCESS_TOKEN=
